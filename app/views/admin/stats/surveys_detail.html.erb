<%= back_link_to surveys_admin_stats_path %>

<p></p>
<h2 class="inline-block">Respuestas de <%= @survey.title %></h3>

<div class="survey-stats-container">
  <% if @answers_by_user.empty? %>
    <div class="callout warning">
      <strong>La consulta no tiene respuestas.</strong>
    </div>
  <% else %>
    <table style="white-space: nowrap;">
      <thead>
        <% @answers_by_user.values.first.keys.each do |key| %>
          <th scope="col"><%= key %></th>
        <% end %>
      </thead>
      <tbody>
        <% @answers_by_user.keys.each do |answer_key| %>
          <tr>
          <% @answers_by_user[answer_key].values.each do |answer_value| %>
            <td>
              <% if answer_value.is_a?(Hash) %>
                <% if answer_value["type"] == Survey::Item::ITEM_TYPE_ATTACHMENT && answer_value["data"].is_a?(Integer) %>
                  <%= link_to "Descargar archivo", url_for(Document.find(answer_value["data"]).attachment), download: true %>
                <% else %>
                  <%= answer_value["data"] %>
                <% end %>
              <% else %>
                <%= answer_value %>
              <% end %>
            </td>
          <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
