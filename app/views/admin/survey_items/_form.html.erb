<div class="margin-top">
  <%=
    form_with model: [:admin, @survey_item],
    url: action_name == 'edit' ? admin_survey_survey_item_path(@survey.id, @survey_item.id) : admin_survey_survey_items_path(@survey.id),
    local: true do |form|
  %>
    <div class="field">
      <%= form.number_field :position, label: 'Posición', min: 1, step: 1, value: @survey_item.position || 1, required: true %>
    </div>

    <div class="field">
      <%= form.select(
        :item_dependency_id,
        (@allowed_survey_item_dependencies || []).map { |r| [r.title, r.id]},
        {
          include_blank: "Ninguna",
          label: "Dependencia",
        },
        { disabled: @allowed_survey_item_dependencies.blank?}
      ) %>
    </div>

    <div class="field" id="dependency_response_field" style="display: none;">
      <label for="survey_item_item_dependency_answer">Respuesta de la dependencia</label>
      <select id="survey_item_item_dependency_answer" name="survey_item[item_dependency_answer]">
      </select>
    </div>

    <div class="field">
      <%= form.text_field :title, label: 'Título', required: true %>
    </div>

    <div class="field">
      <%= form.select :item_type,
        Survey::Item::ITEM_TYPES.map { |item_type| [
            Survey::Item::ITEM_TYPE_TRANSLATIONS[item_type],
            item_type
          ]
        },
        {
          include_blank: 'Elige un tipo de votación',
          label: 'Tipo de votación',
        },
        {
          required: true
        }
      %>
    </div>

    <div class="field" id="item_data_container">
      <%= form.text_field :data,
        label: 'Opciones',
        required: true,
        hint: 'Ingresa las opciones separadas por una coma (,)',
        value: action_name == 'edit' ? @survey_item.data.join(', ') : ''
      %>
    </div>

    <div class="field" id="required-field">
      <%=
        form.check_box :required,
        label: "¿Campo obligatorio?"
      %>
    </div>

    <div class="actions">
      <% if action_name == 'edit' %>
        <%= form.submit 'Editar elemento', class: 'button' %>
      <% else %>
        <%= form.submit 'Crear elemento', class: 'button' %>
      <% end %>
    </div>
  <% end %>
</div>

<script>
$(document).ready(function() {
  if ($('#survey_item_item_type').val() === '<%= Survey::Item::ITEM_TYPE_TEXT %>') {
    $('#item_data_container').hide()
    $('#survey_item_data').prop('required', false)
  }

  var dependencyId = $('#survey_item_item_dependency_id').val();
  var dependencyAnswer = '<%= @survey_item.item_dependency_answer %>';
  var surveyItemsData = <%= @allowed_survey_item_data.to_json.html_safe %>;

  if (dependencyId && dependencyAnswer) {
    $('#survey_item_required').prop('checked', true);
    $('#survey_item_required').prop('required', true);
    $('#survey_item_required').prop('disabled', true);

    var selectedItemData = surveyItemsData.find(item => item[0] == dependencyId);
    if (selectedItemData) {
      var options = selectedItemData[1].map(function(item) {
        return '<option value="' + item + '"' + (item === dependencyAnswer ? ' selected' : '') + '>' + item + '</option>';
      }).join('');
      $('#survey_item_item_dependency_answer').html(options);
      $('#dependency_response_field').show();
    }
  }
})

$('#survey_item_item_type').on('change', function() {
  if (this.value === '<%= Survey::Item::ITEM_TYPE_TEXT %>') {
    $('#item_data_container').hide()
    $('#survey_item_data').prop('required', false)
  } else if (this.value === '<%= Survey::Item::ITEM_TYPE_RANKING %>') {
    $('#required-field').hide()
  } else {
    $('#required-field').show()
    $('#item_data_container').show()
    $('#survey_item_data').prop('required', true)
  }
})

$('#survey_item_data').keyup(function() {
  if (this.value !== '<%= Survey::Item::ITEM_TYPE_TEXT %>') {
    let element = document.getElementById('survey_item_data')

    if (element.value.trim().split(',').length <= 1) {
      element.setCustomValidity('Debes ingresar al menos una opción.')
    }
    else if (element.value.trim().substring(0, 1) === ',') {
      element.setCustomValidity('No puede comenzar con una coma.')
    }
    else if (element.value.trim().slice(-1) === ',') {
      element.setCustomValidity('No puede terminar con una coma.')
    } else {
      element.setCustomValidity('')
    }
  }
})

$('#survey_item_item_dependency_id').on('change', function() {
  var dependencyId = $(this).val();
  var surveyItemsData = <%= @allowed_survey_item_data.to_json.html_safe %>;
  var selectedItemData = surveyItemsData.find(item => item[0] == dependencyId);

  if (selectedItemData) {
    $('#survey_item_required').prop('checked', true);
    $('#survey_item_required').prop('required', true);
    $('#survey_item_required').prop('disabled', true);

    var options = selectedItemData[1].map(function(item) {
      return '<option value="' + item + '">' + item + '</option>';
    }).join('');

    $('#survey_item_item_dependency_answer').html(options);
    $('#dependency_response_field').show();
  } else {
    $('#survey_item_required').prop('disabled', false);
    $('#dependency_response_field').hide();
  }
});
</script>
