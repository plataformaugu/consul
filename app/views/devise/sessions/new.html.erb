<% provide :title do %><%= t("devise_views.sessions.new.title") %><% end %>
<h2 class="text-center"><%= t("devise_views.sessions.new.title") %></h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="row">
    <div class="flex-row flex-jc-center" style="margin: 6rem 0;">
      <a class="btn-cu btn-m btn-color-estandar" href="<%= ClaveUnica.new.get_authentication_url %>" title="Iniciar sesión en ClaveÚnica">
        <span class="cl-claveunica"></span>
        <span class="texto">Iniciar sesión</span>
      </a>
    </div>
  </div>
<% end %>

<%= render "devise/shared/links" %>
