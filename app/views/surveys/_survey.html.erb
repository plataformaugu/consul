<div id="<%= dom_id(survey) %>" class="custom-card" data-type="survey">
  <div class="custom-card-header">
    <% if survey.main_theme.present? %>
      <%= link_to survey.main_theme, style: 'text-decoration: none;', target: '_blank' do %>
      <div class="c-c-h-theme-container">
        <div><%= image_tag survey.main_theme.icon %></div>
        <h3><%= survey.main_theme.name %></h3>
      </div>
      <% end %>
    <% else %>
      <h3>
        Categoría
      </h3>
    <% end %>
  </div>
  <% if survey.image.attached? %>
    <div class="custom-card-image">
      <%= image_tag survey.image %>

      <% if survey.is_expired? %>
        <div class="custom-card-image-container-text">
          <div class="custom-card-image-text">
            <h4><%= survey.readable_name.titleize %> Finalizada</h4>
          </div>
        </div>
      <% end %>
    </div>
  <% elsif survey.main_theme.present? %>
    <div class="custom-card-image">
      <%= image_tag survey.main_theme.icon %>

      <% if survey.is_expired? %>
        <div class="custom-card-image-container-text">
          <div class="custom-card-image-text">
            <h4><%= survey.readable_name.titleize %> Finalizada</h4>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="custom-card-image">
      <%= image_tag 'https://picsum.photos/500' %>
      <% if survey.is_expired? %>
        <div class="custom-card-image-container-text">
          <div class="custom-card-image-text">
            <h4><%= survey.readable_name.titleize %> Finalizada</h4>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
  <div class="custom-card-content" style="<%= survey.image.attached? ? 'height: 50%;' : 'height: 100%;' %>">
    <div>
      <h3 style="text-align: center !important;"><%= survey.title %></h3>
    </div>
    <div class="custom-card-content-footer">
      <% if survey.is_active? and (survey.end_time.to_date - Time.now.to_date).to_i > 0 %>
        <div style="display: flex; justify-content: center; gap: 0.5rem;" class="mb-1">
          <span>Días para cerrar la votación</span>
          <strong>
            <% if survey.is_active? %>
              <%= (survey.end_time.to_date - Time.now.to_date).to_i >= 0 ? (survey.end_time.to_date - Time.now.to_date).to_i : 0 %></strong>
            <% else %>
              0
            <% end %>
          </strong>
        </div>
      <% end %>

      <%= link_to "Ver #{survey.readable_name}", survey_path(survey.id), class: 'button expanded large', style: 'margin-bottom: 5px;' %>
    </div>
  </div>
</div>
