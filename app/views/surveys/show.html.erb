<% provide :title do %><%= @survey.title %><% end %>
<% content_for :meta_description do %><%= truncate(@survey.body) %><% end %>
<% provide :social_media_meta_tags do %>
  <%=
    render "shared/social_media_meta_tags",
    social_url: survey_url(@survey),
    social_title: @survey.title,
    social_description: truncate(@survey.body)
  %>
<% end %>
<% content_for :canonical do %>
  <%= render "shared/canonical", href: survey_url(@survey) %>
<% end %>

<%= render "shared/section_header",
    color: @survey.main_theme.primary_color.present? ? @survey.main_theme.primary_color : "#f25b86",
    section_image: @survey.main_theme.image.present? ? @survey.main_theme.image : "/images/h-consultas.svg",
    title: @survey.title,
    pre_title: @survey.main_theme.present? ? @survey.main_theme.name : nil,
    show_buildings: true
%>
<main>
  <div id="<%= dom_id(@survey) %>" class="row">
    <div class="small-12 medium-9 column">
      <%= back_link_to surveys_path type: @survey.survey_type %>

      <div class="margin-top">
        <h1><%= @survey.title %></h1>
        <p>
         <%= @survey.created_at.strftime('%d/%m/%Y %H:%M') %>
        </p>

        <p class="mt-2"><%= wysiwyg(@survey.body) %></p>

        <% if current_user.nil? %>
          <div class="callout primary">
            <%= sanitize(t("polls.show.cant_answer_not_logged_in",
                  signin: link_to_signin(class: "probe-message"),
                  signup: link_to_signup(class: "probe-message"))) %>
          </div>
        <% elsif @survey.is_expired? %>
          <div class="callout warning">
            <%= @survey.readable_name.titleize %> finalizada.
          </div>

          <div class="row margin-top">
            <div class="small-12 column">
              <ul class="tabs" data-tabs id="survey-tabs">
                <li class="tabs-title is-active"><a data-tabs-target="information" aria-selected="true" href="#information">Información</a></li>
                <% if @survey.show_results %>
                  <li class="tabs-title"><a data-tabs-target="results" href="#results">Resultados</a></li>
                <% end %>
                <% if @survey.show_stats %>
                  <li class="tabs-title"><a data-tabs-target="stats" href="#stats">Estadísticas de participación</a></li>
                <% end %>
              </ul>
              <div class="tabs-content" data-tabs-content="survey-tabs">
                <div class="tabs-panel is-active" id="information">
                  <%= render 'information' %>
                </div>
                <% if @survey.show_results %>
                  <div class="tabs-panel" id="results">
                    <%= render 'results' %>
                </div>
                <% end %>
                <% if @survey.show_stats %>
                  <div class="tabs-panel" id="stats">
                    <%= render 'stats' %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% elsif !current_user.manager? and @survey.answered_by_user?(current_user) %>
          <div class="callout success">
            ¡Muchas gracias por participar!<br>
            Tus respuestas han sido registradas correctamente.
          </div>
        <% else %>
          <div>
            <%= form_with url: send_answers_survey_path, scope: 'answer' do |form| %>
              <div style="display: flex; flex-direction: column; gap: 1rem;">
                <% @survey.items.where(item_dependency_id: nil).order(:position, :id).each do |survey_item| %>
                  <%= render survey_item.component %>
                <% end %>
              </div>

              <% if !@survey.answered_by_user?(current_user) %>
                <%= form.submit 'Confirmar respuestas', class: 'button', name: 'confirm' %>
              <% end %>
              <% if current_user.manager? %>
                <%= form.submit 'Confirmar respuestas en nombre de otra persona', class: 'button', name: 'manager_confirm' %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="small-12 medium-3 column">
      <div class="row">
        <div class="small-12 column">
          <div style="text-align: right;" class="mb-1">
            <% if @survey.pdf_link.present? %>
              <%= link_to @survey.pdf_link, target: '_blank', style: 'color: #727176; text-decoration: none;' do %>
                <%= image_tag '/images/pdf-icon.svg', style: 'width: 2em' %> <small><strong><u>Ver bases</u></strong></small>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
      <% if current_user and current_user.administrator? %>
        <div class="sidebar-divider"></div>
        <p class="sidebar-title">Administrar</p>
        <div class="show-actions-menu">
          <%=
            link_to "Editar #{@survey.readable_name}",
            edit_admin_survey_path(@survey),
            style: 'color: white;',
            class: 'button small expanded'
          %>
          <%=
            link_to "Eliminar #{@survey.readable_name}",
            admin_survey_path(@survey),
            style: 'color: white;',
            class: 'button small alert expanded',
            method: :delete,
            data: { confirm: "¿Estás segur@ que deseas eliminar esta #{@survey.readable_name}?" }
          %>
        </div>
      <% end %>
      
      <div class="sidebar-divider"></div>
      <p class="sidebar-title">Compartir</p>
      <div class="show-actions-menu">
        <%= render "shared/social_share",
          title: @survey.title,
          url: survey_url(@survey),
          description: @survey.body,
          mobile: @survey.title %>
      </div>

    </div>
  </div>

  <div class="tabs-content" data-tabs-content="polls_tabs">
    <%= render "filter_subnav" %>

    <div class="tabs-panel is-active" id="tab-comments">
      <%= render "comments" %>
    </div>
  </div>
</main>

<div class="general-footer-container">
  <%= render 'shared/waves_footer', color1: @survey.main_theme.secondary_color, color2: @survey.main_theme.primary_color do %>
  <% end %>
</div>
